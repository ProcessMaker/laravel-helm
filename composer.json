{
    "name": "processmaker/laravel-helm",
    "description": "Laravel wrapper for HELM v3",
    "version": "1.0.2",
    "type": "library",
    "require": {
        "illuminate/support": "^12.0",
        "php": "^8.4|^8.5",
        "symfony/process": "^6.2|^7.0"
    },
    "require-dev": {
        "orchestra/testbench": "^10.0",
        "phpunit/phpunit": "^12.0"

    },
    "license": "Apache-2.0",
    "autoload": {
        "psr-4": {
            "ProcessMaker\\LaravelHelm\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "ProcessMaker\\LaravelHelm\\Tests\\": "tests/"
        }
    },
    "authors": [
        {
            "name": "ProcessMaker",
            "email": "processmaker@processmaker.com"
        }
    ],
    "extra": {
        "laravel": {
            "providers": [
                "ProcessMaker\\LaravelHelm\\HelmServiceProvider"
            ]
        }
    },
    "scripts": {
        "test": "vendor/bin/phpunit"
    },
    "config": {
        "sort-packages": true
    }
}
